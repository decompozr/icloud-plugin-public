# Build for the runtime OS/architecture. Never copy host node_modules or .env.
FROM oven/bun:1.4.2 AS build
WORKDIR /build
COPY package.json bun.lock LICENSE THIRD_PARTY_NOTICES.md plugin.json ./
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
COPY skills ./skills
COPY bin ./bin
RUN bun install --frozen-lockfile
RUN bun bin/build && bun bin/build-artifact /artifact

FROM oven/bun:1.4.2 AS runtime
WORKDIR /opt/icloud
COPY --from=build /artifact/ ./
USER root
RUN mkdir -p /state /custody /config /diagnostics && chown 10001:10001 /state /custody /config /diagnostics && chmod 700 /state /custody
# Public plugin templates may originate in an owner-only checkout.
RUN find /opt/icloud/apps/studio/dist/server/plugin-template -type d -exec chmod 755 {} + && find /opt/icloud/apps/studio/dist/server/plugin-template -type f -exec chmod 644 {} +
USER 10001:10001
EXPOSE 4100 4101
ENTRYPOINT ["bun", "apps/studio/dist/server/index.js", "--config", "/config/config.toml"]
