# Copy to apps/icloud/.env locally. Never paste actual credentials into chat or commit them.
ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=
MAIL_ALLOW_WRITES=false
MAIL_ALLOW_SEND=false
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8787
# HTTP only: replace every placeholder with your own provider configuration.
MCP_PUBLIC_URL=https://host.tailnet.ts.net/icloud/mcp
MCP_OAUTH_ISSUER=https://issuer.example.com/
MCP_OAUTH_AUDIENCE=https://host.tailnet.ts.net/icloud/mcp
MCP_OAUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
MCP_OAUTH_SCOPES=mail.read
MCP_OAUTH_ALLOWED_SUBJECTS=REPLACE_WITH_OWNER_SUBJECT
