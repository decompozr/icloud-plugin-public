{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "bun",
      "$app/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "build/**/*.ts"
  ],
  "extends": "$app/tsconfig"
}
