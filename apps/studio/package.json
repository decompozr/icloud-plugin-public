{
  "name": "@icloud-plugin/studio",
  "version": "0.1.113",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../packages/tooling/src/build-application.ts",
    "typecheck": "bun run typecheck:ui && bun run typecheck:server",
    "test": "bun test src server",
    "render:brand": "bun build/render-brand.ts",
    "build:ui": "bun build/build.ts",
    "typecheck:ui": "bun build/check-ui.ts",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "build:types": "tsc --project tsconfig.server.build.json",
    "start": "bun dist/server/index.js",
    "dev": "bun run build:ui && bun --watch server/index.ts",
    "runtime": "bun dist/server/index.js"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@simplewebauthn/browser": "14.0.0",
    "better-auth": "1.7.7",
    "i18next": "25.6.0",
    "jose": "6.2.12",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2",
    "@decompozr/account": "workspace:*",
    "@decompozr/mail": "workspace:*",
    "@decompozr/calendar": "workspace:*",
    "@decompozr/photos": "workspace:*",
    "@decompozr/homekit": "workspace:*",
    "svelte": "5.57.1",
    "@decompozr/ui": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "1.4.2",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "7.0.12",
    "cbor-x": "1.6.4",
    "typescript": "5.9.3",
    "imapflow": "1.7.8",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "vite": "8.3.3"
  },
  "packageManager": "bun@1.4.2"
}
