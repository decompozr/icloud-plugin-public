{
  "name": "icloud-plugin",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun ./bin/build",
    "typecheck": "bun run --cwd apps/icloud typecheck && bun run --cwd packages/tooling typecheck",
    "test": "bun run --cwd apps/icloud test && bun run --cwd packages/tooling test",
    "dev": "bun ./bin/dev",
    "start": "bun ./bin/runtime",
    "test:playground": "bun run --cwd playground test",
    "release": "bun ./bin/release",
    "runtime": "bun ./bin/runtime",
    "e2e": "bun run --cwd apps/e2e test",
    "checkpoint": "bun run typecheck && bun run build && bun run test && bun run e2e",
    "build:artifact": "bun ./bin/build-artifact",
    "build:container": "bun ./bin/build-container",
    "install:artifact": "bun ./bin/install",
    "export:plugin": "bun ./bin/export-plugin"
  }
}
