{
  "name": "@decompozr/account",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./ui/index.ts",
    "./ui/*": "./ui/*",
    "./ui/*.js": "./ui/*.ts",
    "./ui/*.svelte.js": "./ui/*.svelte.ts",
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "bun ../../packages/tooling/src/build-account.ts",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "better-auth": "1.7.7",
    "jose": "6.2.12",
    "zod": "3.25.76",
    "@decompozr/ui": "workspace:*",
    "@simplewebauthn/browser": "14.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "svelte": "5.57.1"
  },
  "packageManager": "bun@1.4.2",
  "version": "0.1.2",
  "files": [
    "dist",
    "ui",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "svelte": "5.57.1"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
