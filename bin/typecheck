#!/usr/bin/env bun
import{command}from'../packages/tooling/src/command.js';
await command([process.execPath,'run','--cwd','modules/account','build']);
await command([process.execPath,'run','--cwd','modules/mail','build']);
await command([process.execPath,'run','--cwd','modules/calendar','build']);
await command([process.execPath,'run','--cwd','modules/homekit','build']);
await command([process.execPath,'run','--cwd','modules/photos','build']);
await command([process.execPath,'run','--cwd','apps/studio','build:ui']);
await command([process.execPath,'run','--cwd','apps/studio','typecheck']);
for(const owner of ['packages/tooling'])await command([process.execPath,'run','--cwd',owner,'typecheck']);
